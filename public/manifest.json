{
  "manifest_version": 3,
  "name": "书签清理与归档器",
  "description": "用于整理、清理和归档浏览器书签的扩展工作区。",
  "version": "0.1.0",
  "permissions": ["bookmarks", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "打开书签清理与归档工作区"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  }
}
